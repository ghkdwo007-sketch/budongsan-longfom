# 결과물 (개인 영상 처리 결과 — 절대 커밋 X)
output/

# 사용자 개인 설정 override (예시는 config.json.example 로 제공)
# 앞의 / 가 없으면 profiles/*/config.json 까지 제외돼 프로파일이 통째로 빠진다
/config.json

# 로컬 전용 설정 — 개인 경로/촬영본 폴더명이 들어간다
.claude/settings.local.json

# 미디어 파일
*.mp4
*.mov
*.m4v
*.mkv
*.wav
*.mp3
*.aac

# 파이썬 캐시
__pycache__/
*.pyc
*.pyo

# 백업/작업 중간물
**/_backup/
**/_workspace/
**/_workspace_prev/

# macOS
.DS_Store
